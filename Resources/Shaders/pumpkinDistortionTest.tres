code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D noiseTexture;



void fragment() {
	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(noiseTexture, UV);


	vec4 n_out12p0;
// Texture2D:12
	n_out12p0 = texture(TEXTURE, UV);


// VectorOp:13
	vec4 n_out13p0 = n_out8p0 + n_out12p0;


// Output:0
	COLOR.rgb = vec3(n_out13p0.xyz);


}
