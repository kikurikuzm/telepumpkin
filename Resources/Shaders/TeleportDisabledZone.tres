code = "shader_type canvas_item;
render_mode blend_mix;

uniform float scroll = 0.5;
uniform sampler2D noise : source_color, repeat_enable;
uniform sampler2D screen_tex_frg_11 : hint_screen_texture;



void fragment() {
// ColorConstant:19
	vec4 n_out19p0 = vec4(1.000000, 0.736968, 0.865720, 1.000000);


// Input:13
	vec2 n_out13p0 = SCREEN_UV;


// Input:14
	vec2 n_out14p0 = SCREEN_PIXEL_SIZE;


// Input:5
	vec2 n_out5p0 = SCREEN_PIXEL_SIZE;


// Input:7
	float n_out7p0 = TIME;


// FloatParameter:10
	float n_out10p0 = scroll;


// FloatOp:8
	float n_out8p0 = n_out7p0 * n_out10p0;


// VectorCompose:6
	float n_in6p0 = 0.00000;
	vec2 n_out6p0 = vec2(n_in6p0, n_out8p0);


// VectorOp:9
	vec2 n_out9p0 = n_out5p0 + n_out6p0;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out9p0 * n_in4p1 + UV;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(noise, n_out4p0);


// VectorOp:12
	vec2 n_out12p0 = vec2(n_out2p0.xy) + n_out5p0;


// VectorOp:17
	vec2 n_in17p1 = vec2(0.02000, 0.01000);
	vec2 n_out17p0 = n_out12p0 * n_in17p1;


// VectorOp:18
	vec2 n_in18p1 = vec2(-0.01000, 0.00000);
	vec2 n_out18p0 = n_out17p0 + n_in18p1;


// VectorOp:16
	vec2 n_out16p0 = n_out14p0 + n_out18p0;


// VectorOp:15
	vec2 n_out15p0 = n_out13p0 + n_out16p0;


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(screen_tex_frg_11, n_out15p0);


// ColorOp:20
	vec3 n_out20p0 = vec3(1.0) - (vec3(1.0) - vec3(n_out19p0.xyz)) / (vec3(n_out11p0.xyz));


// Output:0
	COLOR.rgb = n_out20p0;


}
