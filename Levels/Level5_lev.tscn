[sub_resource type="Resource" id="Resource_xfgph"]
script = ExtResource("11_deb3b")
dialogueText = "[u]Tip:[/u]
You can kick pumpkins by pressing the [outline_color=white][outline_size=2]B[/outline_size][/outline_color] button while moving!"
metadata/_custom_type_script = "uid://d3q3ufenhm5w3"

[sub_resource type="Resource" id="Resource_08inn"]
script = ExtResource("11_deb3b")
dialogueText = "Be sure to time it so that you flash before getting stopped by the pumpkin. "
metadata/_custom_type_script = "uid://d3q3ufenhm5w3"

[sub_resource type="Resource" id="Resource_hpyeu"]
script = ExtResource("10_uu7ub")
conversationArray = Array[ExtResource("11_deb3b")]([SubResource("Resource_xfgph"), SubResource("Resource_08inn")])
metadata/_custom_type_script = "uid://cgtgjpboysb1f"

[sub_resource type="Resource" id="Resource_hgjbs"]
script = ExtResource("11_deb3b")
dialogueText = "I.O.U. a secret!..."
metadata/_custom_type_script = "uid://d3q3ufenhm5w3"

[sub_resource type="Resource" id="Resource_57cdb"]
script = ExtResource("11_deb3b")
dialogueText = "Well, while you're here, I'll offer you a tip."
goToNextConversation = true
metadata/_custom_type_script = "uid://d3q3ufenhm5w3"

[sub_resource type="Resource" id="Resource_2tncn"]
script = ExtResource("10_uu7ub")
conversationArray = Array[ExtResource("11_deb3b")]([SubResource("Resource_hgjbs"), SubResource("Resource_57cdb")])
metadata/_custom_type_script = "uid://cgtgjpboysb1f"

[sub_resource type="Resource" id="Resource_7rkx8"]
script = ExtResource("11_deb3b")
dialogueText = "[u]Tip:[/u]
If you start charging a jump mid-air and hold it till landing, your jump will charge much faster!"
metadata/_custom_type_script = "uid://d3q3ufenhm5w3"

[sub_resource type="Resource" id="Resource_4ryps"]
script = ExtResource("11_deb3b")
dialogueText = "How's that for a tip? Do note that this can't be done after a double-jump. It's one or the other!"
metadata/_custom_type_script = "uid://d3q3ufenhm5w3"

[sub_resource type="Resource" id="Resource_cyw8v"]
script = ExtResource("10_uu7ub")
conversationArray = Array[ExtResource("11_deb3b")]([SubResource("Resource_7rkx8"), SubResource("Resource_4ryps")])
metadata/_custom_type_script = "uid://cgtgjpboysb1f"

[sub_resource type="Resource" id="Resource_uu7ub"]
script = ExtResource("11_deb3b")
dialogueText = "The kick can do things that teleporting can't, but the teleport can do things that kicking can't. Keep this in mind if you're ever stumped!"
metadata/_custom_type_script = "uid://d3q3ufenhm5w3"

[sub_resource type="Resource" id="Resource_deb3b"]
script = ExtResource("10_uu7ub")
