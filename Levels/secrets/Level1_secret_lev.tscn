[sub_resource type="Resource" id="Resource_8qe7t"]
script = ExtResource("13_ftv2q")
dialogueText = "The bird looks at you expectantly for a while before breaking the silence.
\"Uhm, well, welcome to my secret! CAW! I like to refer to these as 'pocket-dimensions', but I'm not entirely sure if that's the right term.\""
dialoguePortrait = "smoke"
textSpeed = 0.07
triggerToFire = NodePath("")
currentFocus = NodePath("")
focusPlayer = false
cameraSpeed = 0.1
cameraZoom = 4.0
playerCanMove = false
goToNextConversation = false
manualNextConversation = 0
metadata/_custom_type_script = "uid://d3q3ufenhm5w3"

[sub_resource type="Resource" id="Resource_1td3a"]
script = ExtResource("13_ftv2q")
dialogueText = "\"Anyways, you seem smart enough, CAW! So go solve that puzzle ahead for me! I haven't had anyone to test it in forever...\""
