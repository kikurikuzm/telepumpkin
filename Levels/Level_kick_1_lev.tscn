[sub_resource type="Resource" id="Resource_xpk7d"]
script = ExtResource("12_o838x")
dialogueText = "You can nudge pumpkins by [color=yellow]kicking[/color] them using [action:kick]."
dialoguePortrait = "inspect"
metadata/_custom_type_script = "uid://d3q3ufenhm5w3"

[sub_resource type="Resource" id="Resource_cg7ag"]
script = ExtResource("12_o838x")
dialogueText = "If you hold [action:up] before a [color=yellow]kick[/color] makes contact with a pumpkin, it'll shoot the pumpkin up instead of horizontally!"
dialoguePortrait = "inspect"
metadata/_custom_type_script = "uid://d3q3ufenhm5w3"

[sub_resource type="Resource" id="Resource_661u6"]
script = ExtResource("12_o838x")
dialogueText = "Also, if you're moving fast enough and you hit the pumpkin with your kick [i]just[/i] before you'd bump into it, you'll perform a '[color=yellow]perfect kick[/color]'!"
dialoguePortrait = "inspect"
currentFocus = NodePath("../pumpkin")
metadata/_custom_type_script = "uid://d3q3ufenhm5w3"

